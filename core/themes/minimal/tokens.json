{
  "$comment": "minimal 테마의 디자인 토큰 (PRD §8.4). 각 범주는 순서 있는 배열이다 — soml.Theme의 순서 있는 슬라이스 계약(결정적 CSS 변수·clrScheme·진단)을 파일에서 그대로 유지하려면 JSON 객체의 키 순서에 기대지 않아야 한다. 값의 근거는 core/theme.go의 옛 하드코딩 주석에 있다(수직 리듬·대비율·clrScheme 슬롯).",

  "color": [
    { "name": "fg",      "rgb": "1A1A1A", "slot": "dk1",     "ref": "tx1" },
    { "name": "bg",      "rgb": "FFFFFF", "slot": "lt1",     "ref": "bg1" },
    { "name": "muted",   "rgb": "6B7280", "slot": "dk2",     "ref": "tx2" },
    { "name": "surface", "rgb": "F3F4F6", "slot": "lt2",     "ref": "bg2" },
    { "name": "accent1", "rgb": "0F65F9", "slot": "accent1", "ref": "accent1" }
  ],

  "font": [
    { "name": "heading", "latin": "Noto Sans",      "ea": "Noto Sans CJK KR", "generic": "sans-serif", "scheme": "major" },
    { "name": "body",    "latin": "Noto Sans",      "ea": "Noto Sans CJK KR", "generic": "sans-serif", "scheme": "minor" },
    { "name": "mono",    "latin": "Noto Sans Mono", "ea": "Noto Sans CJK KR", "generic": "monospace" }
  ],

  "space": [
    { "name": "xs",  "px": 6 },
    { "name": "sm",  "px": 12 },
    { "name": "md",  "px": 24 },
    { "name": "lg",  "px": 36 },
    { "name": "xl",  "px": 48 },
    { "name": "2xl", "px": 72 }
  ],

  "radius": [
    { "name": "sm", "px": 6 },
    { "name": "md", "px": 12 },
    { "name": "lg", "px": 24 }
  ],

  "shadow": [
    { "name": "soft", "dist": 4, "dir": 90, "blur": 16, "color": "fg", "alpha": 0.15 }
  ]
}
