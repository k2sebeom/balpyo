<!-- The number in the file name is the slide order. To insert a slide in between, renumbering is the cleaner choice. -->
<slide id="what" layout="content">
  <text role="title">What are we here to say?</text>
  <row gap="lg" align="start">
    <col grow="1" gap="md">
      <text role="heading">The claim in one line</text>
      <ul>
        <li>First reason</li>
        <li>Second reason</li>
      </ul>
    </col>
    <shape type="rounded-rect" fill="surface" w="420" h="180" pad="lg">
      <p color="muted">Shapes can hold text too. Feel free to delete this box.</p>
    </shape>
  </row>
</slide>
