<!-- The cover. Placement comes from the theme's title slots — which is why no child sets align. -->
<slide id="cover" layout="title">
  <text slot="kicker" variant="kicker">NEW DECK</text>
  <text slot="title" role="title">{{.Title}}</text>
  <text slot="subtitle" role="body" color="muted">What is it, in one line?</text>
  <text slot="author" role="caption">{{.Author}}</text>
  <note>Only the presenter sees this line — it opens in the Notes panel of the output.</note>
</slide>
