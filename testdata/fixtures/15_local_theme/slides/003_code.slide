<!-- 코드 색도 이름 단위로 갈린다. corp는 `keyword` 하나만 다시 적었으므로(accent1 = 보라)
     name·attr·string·number·comment 다섯은 minimal의 색 그대로이고, `tabSize`는 적지 않아
     minimal의 2가 그대로 온다 — 그래서 원문의 탭은 산출물에서 두 칸으로 펴진다.

     코드 레이아웃의 배치 CSS도 부모 것이다: corp의 layouts/에는 title.slots.css 한 파일뿐이다. -->
<slide id="local-theme-code" layout="code">
  <text slot="title" role="heading">이름이 같은 것만 갈린다</text>
  <pre slot="code" lang="go">// 테마 이름은 프로젝트의 어휘에서 풀린다: 내장 ∪ themes/이름/.
func loadThemeNamed(fsys fs.FS, name string) (themePackage, error) {
	chain, err := readThemeChain(fsys, name)
	if err != nil {
		return themePackage{}, err
	}
	merged := chain[0]
	for _, child := range chain[1:] {
		merged = mergeRawTheme(merged, child)
	}
	return buildThemePackage(merged)
}</pre>
  <text slot="caption" role="caption">병합은 원문 층에서 끝나고 검사는 그 결과에 한 번 돈다.</text>
  <note>keyword만 corp의 색이다 — 나머지 다섯은 minimal에서 왔다.</note>
</slide>
