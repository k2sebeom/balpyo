<!-- 외관 속성 나머지 전수: `radius`(토큰·수치), `shadow`, `opacity`, `rotate`, `flip`
     (docs/reference/appearance.md). 한 슬라이드에 모으는 이유는 각각이 **한 속성만** 다른 도형을 만들기
     때문이다 — 항목 04·05의 CSS/OOXML 매핑이 서로를 덮어쓰지 않는지 보려면 나머지 조건이
     같아야 한다. 그래서 12종 슬라이드와 달리 type은 전부 rounded-rect·rect로 고정한다.
     `flip`은 좌우 대칭이 아닌 프리셋에서만 눈에 보이므로 chevron을 쓴다.
     그라디언트(`fill="gradient(...)"`)와 색 변형(`shade`/`tint`/`alpha`)은 여기 없다 —
     Iteration 8이다. -->
<slide id="shape-appearance">
  <h2>모서리·그림자·투명도·회전</h2>
  <row gap="md" align="center">
    <shape type="rounded-rect" fill="accent1" radius="sm" w="180" h="120" pad="sm"><text color="bg" align="center" anchor="center">radius=sm</text></shape>
    <shape type="rounded-rect" fill="accent1" radius="lg" w="180" h="120" pad="sm"><text color="bg" align="center" anchor="center">radius=lg</text></shape>
    <shape type="rounded-rect" fill="accent1" radius="32" w="180" h="120" pad="sm"><text color="bg" align="center" anchor="center">radius=32</text></shape>
  </row>
  <row gap="md" align="center">
    <shape type="rect" fill="surface" shadow="soft" w="180" h="120" pad="sm"><text align="center" anchor="center">shadow=soft</text></shape>
    <shape type="rect" fill="accent1" opacity="0.4" w="180" h="120" pad="sm"><text color="bg" align="center" anchor="center">opacity=0.4</text></shape>
    <shape type="rect" fill="accent1" rotate="45" w="120" h="120"/>
    <shape type="chevron" fill="muted" flip="h" w="180" h="120" pad="sm"><text color="bg" align="center" anchor="center">flip=h</text></shape>
  </row>
</slide>
