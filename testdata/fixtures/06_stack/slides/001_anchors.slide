<!-- 06_stack은 겹침 컨테이너 <stack>과 자식 배치 `at`·`x`·`y`의 시험대이자
     문서의 예제 출처다. 계약이 슬라이드 하나에 하나씩 대응한다.

     이 슬라이드 — 9지점 앵커 전수: 같은 크기의 배지 9개가 각 앵커에 붙는다. `at`을 쓰지
     않은 자식은 컨테이너의 `align`/`justify` 기본 정렬을 따르고, `at`이 그것을 자식
     하나에서 덮는다. 좌표 스냅샷의 판정 대상이다. -->
<slide id="anchors">
  <h2>9지점 앵커</h2>
  <stack w="fill" h="360">
    <shape type="rounded-rect" fill="surface" w="fill" h="fill"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="top-left"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="top-center"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="top-right"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="center-left"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="center"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="center-right"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="bottom-left"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="bottom-center"/>
    <shape type="rect" fill="accent1" w="64" h="40" at="bottom-right"/>
  </stack>
</slide>
