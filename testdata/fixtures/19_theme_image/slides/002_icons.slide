<!-- check는 부모(corp)에만 있어 부모의 그림이고, arrow는 자식(corp-dark)이 같은 경로로 덮어 자식의
     그림이다. 같은 아이콘을 두 번 써도 에셋은 하나다. -->
<slide id="image-icons">
  <h2>아이콘 라이브러리</h2>
  <row gap="24">
    <image src="theme:icons/check.png" w="64" alt="확인"/>
    <image src="theme:icons/arrow.png" w="64" alt="화살표"/>
    <image src="theme:icons/check.png" w="32" alt="확인 (작게)"/>
  </row>
</slide>
