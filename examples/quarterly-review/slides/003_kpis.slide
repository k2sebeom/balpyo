<!-- KPI 카드. shape는 type이 필수이고 자식으로 레이아웃 컨테이너(<col>)를 못 받아,
     숫자와 라벨을 도형 안 문단으로 쌓는다. -->
<slide id="kpis">
  <h2>핵심 지표</h2>
  <grid cols="3" gap="lg">
    <shape variant="stat-card" type="rounded-rect" fill="surface" w="fill" h="200" pad="lg">
      <text role="title" color="accent1" align="center">+38%</text>
      <p align="center">월간 활성 사용자</p>
    </shape>
    <shape variant="stat-card" type="rounded-rect" fill="surface" w="fill" h="200" pad="lg">
      <text role="title" color="accent1" align="center">1.2B</text>
      <p align="center">분기 매출(원)</p>
    </shape>
    <shape variant="stat-card" type="rounded-rect" fill="surface" w="fill" h="200" pad="lg">
      <text role="title" color="accent1" align="center">4.6</text>
      <p align="center">앱스토어 평점</p>
    </shape>
  </grid>
  <note>매출은 목표 대비 108%.</note>
</slide>
