<!-- Reference architecture — nested groups are dashed or solid rounded rects on a canvas (cloud,
     region, VPC, two AZs, public and private subnets, the Auto Scaling group). Icons are small
     tiles; request paths are flowing connectors, the alarm loop is a dashed accent connector, and
     numbered badges tie the picture to the four notes below. -->
<slide id="architecture" layout="canvas">
  <text variant="kicker" x="0" y="0">05 · Run it in production</text>
  <h2 x="0" y="28">A highly available web tier on EC2</h2>

  <shape type="rect" fill="none" border="1 solid fg" w="1060" h="370" x="92" y="96"/>
  <text role="caption" size="14" x="104" y="102"><strong>AWS Cloud</strong></text>
  <shape type="rect" fill="none" border="1 dashed accent6" w="1036" h="330" x="104" y="126"/>
  <text role="caption" size="14" color="accent6" x="116" y="130"><strong>Region</strong></text>
  <shape type="rect" fill="none" border="2 solid accent4" w="690" h="296" x="196" y="150"/>
  <text role="caption" size="14" color="accent4" x="208" y="154"><strong>VPC</strong> 10.0.0.0/16</text>

  <shape type="rect" fill="none" border="1 dashed accent6" w="580" h="122" x="296" y="180"/>
  <text role="caption" size="14" color="accent6" x="836" y="182"><strong>AZ A</strong></text>
  <shape type="rect" fill="none" border="1 dashed accent6" w="580" h="122" x="296" y="314"/>
  <text role="caption" size="14" color="accent6" x="836" y="316"><strong>AZ B</strong></text>
  <shape type="rect" fill="tint(accent3, 88%)" border="none" w="200" h="92" x="306" y="200"/>
  <text role="caption" size="14" color="accent3" x="314" y="204"><strong>Public subnet</strong></text>
  <shape type="rect" fill="tint(accent3, 88%)" border="none" w="200" h="92" x="306" y="334"/>
  <text role="caption" size="14" color="accent3" x="314" y="338"><strong>Public subnet</strong></text>
  <shape type="rect" fill="tint(accent6, 88%)" border="none" w="350" h="92" x="516" y="200"/>
  <shape type="rect" fill="tint(accent6, 88%)" border="none" w="350" h="92" x="516" y="334"/>
  <shape type="rect" fill="none" border="2 dashed accent1" w="296" h="220" x="530" y="194"/>
  <text role="caption" size="14" color="accent1" x="540" y="198"><strong>Auto Scaling group</strong></text>

  <shape type="rounded-rect" id="users" fill="fg" border="none" radius="sm" w="52" h="52" x="0" y="260"><p align="center" anchor="center" size="13" color="bg"><strong>Users</strong></p></shape>
  <shape type="rounded-rect" id="igw" fill="accent4" border="none" radius="sm" w="48" h="48" x="172" y="262"><p align="center" anchor="center" size="12" color="bg"><strong>IGW</strong></p></shape>
  <shape type="rounded-rect" id="alb" fill="accent4" border="none" radius="sm" w="60" h="60" x="380" y="256" enter="zoom"><p align="center" anchor="center" size="14" color="bg"><strong>ALB</strong></p></shape>
  <shape type="rounded-rect" id="nat-a" fill="bg" border="1 solid accent4" radius="sm" w="44" h="28" x="452" y="226"><p align="center" anchor="center" size="11" color="accent4">NAT</p></shape>
  <shape type="rounded-rect" id="nat-b" fill="bg" border="1 solid accent4" radius="sm" w="44" h="28" x="452" y="388"><p align="center" anchor="center" size="11" color="accent4">NAT</p></shape>
  <shape type="rounded-rect" id="web1" fill="accent1" border="none" radius="sm" w="104" h="40" x="560" y="232"><p align="center" anchor="center" size="15" color="bg"><strong>web-1</strong></p></shape>
  <shape type="rounded-rect" id="web2" fill="accent1" border="none" radius="sm" w="104" h="40" x="712" y="232"><p align="center" anchor="center" size="15" color="bg"><strong>web-2</strong></p></shape>
  <shape type="rounded-rect" id="web3" fill="accent1" border="none" radius="sm" w="104" h="40" x="560" y="362"><p align="center" anchor="center" size="15" color="bg"><strong>web-3</strong></p></shape>
  <shape type="rounded-rect" id="web4" fill="accent1" border="none" radius="sm" w="104" h="40" x="712" y="362"><p align="center" anchor="center" size="15" color="bg"><strong>web-4</strong></p></shape>
  <shape type="rounded-rect" id="cw" fill="accent5" border="none" radius="sm" w="56" h="56" x="976" y="176"><p align="center" anchor="center" size="12" color="bg"><strong>Watch</strong></p></shape>
  <text role="caption" size="14" x="1038" y="194" w="100">CloudWatch</text>
  <shape type="rounded-rect" id="scaling" fill="accent1" border="none" radius="sm" w="56" h="56" x="976" y="326"><p align="center" anchor="center" size="12" color="bg"><strong>Scale</strong></p></shape>
  <text role="caption" size="14" x="1038" y="344" w="100">Auto Scaling</text>

  <connector from="users" to="igw" flow enter="draw"/>
  <connector from="igw" to="alb" flow enter="draw"/>
  <connector from="alb" to="web1" route="curved" from-side="right" to-side="left" flow enter="draw"/>
  <connector from="alb" to="web3" route="curved" from-side="right" to-side="left" flow enter="draw"/>
  <connector from="web2" to="cw" route="curved" from-side="right" to-side="left" variant="dashed" line="2 dashed accent5" enter="draw"/>
  <connector from="cw" to="scaling" line="2 dashed accent5" label="alarm" enter="draw"/>
  <connector from="scaling" to="web4" route="curved" from-side="left" to-side="right" line="2 dashed accent5" enter="draw"/>

  <shape type="ellipse" fill="fg" border="none" w="24" h="24" x="132" y="246"><p align="center" anchor="center" size="13" color="bg"><strong>1</strong></p></shape>
  <shape type="ellipse" fill="fg" border="none" w="24" h="24" x="436" y="248"><p align="center" anchor="center" size="13" color="bg"><strong>2</strong></p></shape>
  <shape type="ellipse" fill="fg" border="none" w="24" h="24" x="802" y="200"><p align="center" anchor="center" size="13" color="bg"><strong>3</strong></p></shape>
  <shape type="ellipse" fill="accent5" border="none" w="24" h="24" x="1092" y="280"><p align="center" anchor="center" size="13" color="bg"><strong>4</strong></p></shape>

  <grid cols="4" gap="lg" w="1152" x="0" y="488">
    <row gap="sm" align="start" enter="rise"><shape type="ellipse" fill="fg" border="none" w="28" h="28"><p align="center" anchor="center" size="14" color="bg"><strong>1</strong></p></shape><col gap="0" grow="1" basis="0"><h3 size="19">Edge</h3><text role="caption">Only the gateway and ALB face the internet.</text></col></row>
    <row gap="sm" align="start" enter="rise"><shape type="ellipse" fill="fg" border="none" w="28" h="28"><p align="center" anchor="center" size="14" color="bg"><strong>2</strong></p></shape><col gap="0" grow="1" basis="0"><h3 size="19">Load balancing</h3><text role="caption">The ALB health-checks targets across AZs.</text></col></row>
    <row gap="sm" align="start" enter="rise"><shape type="ellipse" fill="fg" border="none" w="28" h="28"><p align="center" anchor="center" size="14" color="bg"><strong>3</strong></p></shape><col gap="0" grow="1" basis="0"><h3 size="19">Private instances</h3><text role="caption">No public IPs; outbound through NAT.</text></col></row>
    <row gap="sm" align="start" enter="rise"><shape type="ellipse" fill="accent5" border="none" w="28" h="28"><p align="center" anchor="center" size="14" color="bg"><strong>4</strong></p></shape><col gap="0" grow="1" basis="0"><h3 size="19">Self-healing</h3><text role="caption">Alarms scale out and replace instances.</text></col></row>
  </grid>
  <note>Requests come in through the internet gateway to the load balancer, which spreads them over instances in two Availability Zones. CloudWatch alarms drive Auto Scaling, which adds capacity and replaces unhealthy instances.</note>
</slide>
