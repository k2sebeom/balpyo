<!-- Agenda — a pale panel on the left holds the heading; the right column is a numbered list of the
     five chapters, each with a round SVG icon badge and a hairline between rows. The panel bleeds to the
     slide edge with a negative offset on the canvas. -->
<slide id="agenda" layout="canvas" enter="rise">
  <shape type="rect" fill="surface" border="none" w="400" h="720" x="-64" y="-64" enter="none"/>
  <col gap="sm" w="300" x="0" y="150">
    <text variant="kicker">Today</text>
    <h1 size="64">Agenda</h1>
    <p color="muted" size="22">Five ideas that take you from “what is a server in the cloud?” to a resilient architecture.</p>
  </col>
  <col gap="0" w="760" x="392" y="40">
    <row gap="md" align="center" h="96">
      <text size="32" color="muted" w="56">01</text>
      <stack w="52" h="52"><shape type="ellipse" fill="tint(accent1, 85%)" border="none" w="52" h="52"/><image src="assets/icons/elastic.svg" at="center" alt=""/></stack>
      <col gap="0" grow="1"><text role="heading" size="28">Why elastic compute</text><text role="caption">Capacity that follows demand</text></col>
    </row>
    <shape type="rect" fill="surface" border="none" w="fill" h="1"/>
    <row gap="md" align="center" h="96">
      <text size="32" color="muted" w="56">02</text>
      <stack w="52" h="52"><shape type="ellipse" fill="tint(accent4, 85%)" border="none" w="52" h="52"/><image src="assets/icons/anatomy.svg" at="center" alt=""/></stack>
      <col gap="0" grow="1"><text role="heading" size="28">Anatomy of an instance</text><text role="caption">AMI, type, storage, network, identity — and Nitro</text></col>
    </row>
    <shape type="rect" fill="surface" border="none" w="fill" h="1"/>
    <row gap="md" align="center" h="96">
      <text size="32" color="muted" w="56">03</text>
      <stack w="52" h="52"><shape type="ellipse" fill="tint(accent2, 85%)" border="none" w="52" h="52"/><image src="assets/icons/choosing.svg" at="center" alt=""/></stack>
      <col gap="0" grow="1"><text role="heading" size="28">Choosing an instance</text><text role="caption">Families, generations and sizes</text></col>
    </row>
    <shape type="rect" fill="surface" border="none" w="fill" h="1"/>
    <row gap="md" align="center" h="96">
      <text size="32" color="muted" w="56">04</text>
      <stack w="52" h="52"><shape type="ellipse" fill="tint(accent3, 85%)" border="none" w="52" h="52"/><image src="assets/icons/paying.svg" at="center" alt=""/></stack>
      <col gap="0" grow="1"><text role="heading" size="28">Paying for compute</text><text role="caption">On-Demand, Savings Plans, Reserved, Spot</text></col>
    </row>
    <shape type="rect" fill="surface" border="none" w="fill" h="1"/>
    <row gap="md" align="center" h="96">
      <text size="32" color="muted" w="56">05</text>
      <stack w="52" h="52"><shape type="ellipse" fill="tint(accent5, 85%)" border="none" w="52" h="52"/><image src="assets/icons/production.svg" at="center" alt=""/></stack>
      <col gap="0" grow="1"><text role="heading" size="28">Run it in production</text><text role="caption">Lifecycle, reference architecture, first launch</text></col>
    </row>
  </col>
  <note>Five chapters. Each one builds on the previous: why elasticity matters, what an instance is made of, how to choose it, how to pay for it, and how to run it.</note>
</slide>
