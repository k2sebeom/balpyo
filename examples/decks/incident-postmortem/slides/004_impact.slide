<!-- Impact — where a table is what you want, use a table. Twenty cells are twenty cell tags, and the
     grid lines are merged into one by the web's `border-collapse: collapse` and PPTX's shared grid lines.

     Header color and stripes are never painted by hand — header cells (`<th>`) take the theme's header
     values, and `variant="striped"` stripes the odd body rows. Numeric columns are right-aligned with
     `align="end"` (a per-cell appearance override). Column widths are **measured**, not a track list.

     Below the table is the funnel of "so how much did users get hurt": failed payments → succeeded on
     retry → tickets left over. Connectors join the three cards — the card captions say what happened
     between steps. Damage values are `accent5`, recovered values `accent3` (the deck's color rule —
     001_cover). The card row takes the remaining height with `grow="1"`. -->
<slide id="impact" enter="rise">
  <text variant="kicker">Impact</text>
  <h2>Payments took the hit; settlement was untouched</h2>
  <table variant="striped">
    <tr>
      <th>Service</th><th align="end">Peak error rate</th><th align="end">Requests hit</th><th>What users saw</th>
    </tr>
    <tr>
      <td>Payments API</td><td align="end" color="accent5">8.4%</td><td align="end">41,200</td><td>Payment failed, then retried</td>
    </tr>
    <tr>
      <td>Order lookup</td><td align="end">1.1%</td><td align="end">6,800</td><td>2–4 s slower lookups</td>
    </tr>
    <tr>
      <td>Cart</td><td align="end">0.3%</td><td align="end">1,450</td><td>Add-to-cart failures (rare)</td>
    </tr>
    <tr>
      <td>Settlement batch</td><td align="end">0%</td><td align="end">0</td><td>None</td>
    </tr>
  </table>
  <grid cols="3" gap="2xl" grow="1">
    <shape type="rounded-rect" id="failed" variant="card" fill="surface" border="none" w="fill" pad="md">
      <col gap="0" h="fill" justify="center">
        <text role="title" size="48" color="accent5">41,200</text>
        <text role="caption">failed payment requests</text>
      </col>
    </shape>
    <shape type="rounded-rect" id="retried" variant="card" fill="surface" border="none" w="fill" pad="md">
      <col gap="0" h="fill" justify="center">
        <text role="title" size="48" color="accent3">39,900</text>
        <text role="caption">succeeded on retry · 96.8%</text>
      </col>
    </shape>
    <shape type="rounded-rect" id="tickets" variant="card" fill="surface" border="none" w="fill" pad="md">
      <col gap="0" h="fill" justify="center">
        <text role="title" size="48" color="accent5">34<span size="24"> tickets</span></text>
        <text role="caption">to support · no double charges</text>
      </col>
    </shape>
  </grid>
  <connector from="failed" to="retried"/>
  <connector from="retried" to="tickets"/>
  <note>No money was lost. 34 support tickets.</note>
</slide>
