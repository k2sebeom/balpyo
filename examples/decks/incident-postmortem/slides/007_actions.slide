<!-- Actions: the two slots of the two-column layout split "this week / next sprint". Each slot area is a
     grid cell that takes all the height left under the title (the `1fr` row in `two-column.slots.css`),
     and one card per cell fills it with `h="fill"`. The three actions inside a card spread evenly over its
     height with `justify="between"`, each with a number circle and what it prevents.

     Everything on this slide is "what we will do", so it uses only green from the deck's color rule
     (001_cover). Painting the urgent side red was an option, but red means what the incident cost in this
     deck, and using it for the plan would give it two meanings. Instead the this-week number circles are
     filled and the next-sprint ones are outlined — urgency is a difference of fill, not of color. -->
<slide id="actions" layout="two-column" enter="rise">
  <text slot="title" role="heading">Actions to prevent recurrence</text>
  <col slot="left" h="fill">
    <shape type="rounded-rect" variant="card" fill="surface" border="none" w="fill" h="fill" pad="lg">
      <col gap="md" h="fill" justify="between">
        <row gap="sm" align="center"><text role="heading" size="28" color="accent3">This week</text><shape variant="badge" type="rounded-rect" pad="0 sm"><text role="caption">D+3</text></shape></row>
        <row gap="md" align="start"><shape type="ellipse" fill="accent3" border="none" w="40" h="40"><text role="caption" color="bg" align="center" anchor="center"><strong>1</strong></text></shape><col gap="0" grow="1" basis="0"><text role="body">±10% jitter on TTLs</text><text role="caption">All payment caches · blocks fixed TTLs</text></col></row>
        <row gap="md" align="start"><shape type="ellipse" fill="accent3" border="none" w="40" h="40"><text role="caption" color="bg" align="center" anchor="center"><strong>2</strong></text></shape><col gap="0" grow="1" basis="0"><text role="body">5xx alert on 1-min p99</text><text role="caption">Detect in 12 min → target 3 min</text></col></row>
        <row gap="md" align="start"><shape type="ellipse" fill="accent3" border="none" w="40" h="40"><text role="caption" color="bg" align="center" anchor="center"><strong>3</strong></text></shape><col gap="0" grow="1" basis="0"><text role="body">Read pool cap 40 → 96</text><text role="caption">Spare 14 → 70 · alert at 80%</text></col></row>
      </col>
    </shape>
  </col>
  <col slot="right" h="fill">
    <shape type="rounded-rect" variant="card" fill="surface" border="none" w="fill" h="fill" pad="lg">
      <col gap="md" h="fill" justify="between">
        <row gap="sm" align="center"><text role="heading" size="28" color="accent3">Next sprint</text><shape variant="badge" type="rounded-rect" pad="0 sm"><text role="caption">D+14</text></shape></row>
        <row gap="md" align="start"><shape type="ellipse" fill="none" border="2 solid accent3" w="40" h="40"><text role="caption" color="accent3" align="center" anchor="center"><strong>4</strong></text></shape><col gap="0" grow="1" basis="0"><text role="body">Single-flight lock on misses</text><text role="caption">Stops one miss becoming one query</text></col></row>
        <row gap="md" align="start"><shape type="ellipse" fill="none" border="2 solid accent3" w="40" h="40"><text role="caption" color="accent3" align="center" anchor="center"><strong>5</strong></text></shape><col gap="0" grow="1" basis="0"><text role="body">Automatic load shedding</text><text role="caption">At 2% errors — took a human 17 min</text></col></row>
        <row gap="md" align="start"><shape type="ellipse" fill="none" border="2 solid accent3" w="40" h="40"><text role="caption" color="accent3" align="center" anchor="center"><strong>6</strong></text></shape><col gap="0" grow="1" basis="0"><text role="body">Stampede load test</text><text role="caption">A deploy gate · replays 30 min after warm-up</text></col></row>
      </col>
    </shape>
  </col>
  <note>Owners and due dates live in the tickets. Here we only agree on the order.</note>
</slide>
