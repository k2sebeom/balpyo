<!-- Contributing factors: four converge on one outcome. Four factor cards stack on the left, and four
     curved connectors gather into the red circle on the right (47 min — what the incident cost, the deck's
     color rule, 001_cover). It says "four overlapped", not "one root cause", with shape instead of a list.

     Each card puts the factor (left) and the action that blocks it (far right, `accent3` — what we will do)
     on one line — factor and action need to share a card so you can see where the next slide's list comes
     from. The caption below is this slide's conclusion: remove any one of the four. -->
<slide id="factors" enter="rise">
  <text variant="kicker">Contributing factors</text>
  <h2>Four things went wrong at once</h2>
  <row gap="0" align="center" grow="1">
    <col gap="sm" w="760">
      <shape type="rounded-rect" id="f1" variant="card" fill="surface" border="none" w="fill" pad="sm md">
        <row gap="md" align="center">
          <col gap="0" grow="1" basis="0"><text role="heading" size="22">Fixed TTL</text><text role="caption">Warm-up gives every key the same expiry</text></col>
          <text role="caption" color="accent3" w="230" align="end">→ ±10% TTL jitter</text>
        </row>
      </shape>
      <shape type="rounded-rect" id="f2" variant="card" fill="surface" border="none" w="fill" pad="sm md">
        <row gap="md" align="center">
          <col gap="0" grow="1" basis="0"><text role="heading" size="22">No single-flight</text><text role="caption">Every cache miss goes straight to the DB</text></col>
          <text role="caption" color="accent3" w="230" align="end">→ Single-flight on miss</text>
        </row>
      </shape>
      <shape type="rounded-rect" id="f3" variant="card" fill="surface" border="none" w="fill" pad="sm md">
        <row gap="md" align="center">
          <col gap="0" grow="1" basis="0"><text role="heading" size="22">Small read pool</text><text role="caption">Cap 40, normal peak 26 — only 14 spare</text></col>
          <text role="caption" color="accent3" w="230" align="end">→ Cap 96, alert at 80%</text>
        </row>
      </shape>
      <shape type="rounded-rect" id="f4" variant="card" fill="surface" border="none" w="fill" pad="sm md">
        <row gap="md" align="center">
          <col gap="0" grow="1" basis="0"><text role="heading" size="22">5-min average alert</text><text role="caption">Averaging sees sharp spikes late</text></col>
          <text role="caption" color="accent3" w="230" align="end">→ 1-min p99 alert</text>
        </row>
      </shape>
    </col>
    <spacer grow="1"/>
    <shape type="ellipse" id="outcome" fill="accent5" border="none" shadow="soft" w="220" h="220" enter="zoom">
      <col gap="0" align="center" justify="center" h="fill">
        <text role="title" size="56" color="bg" align="center">47<span size="28"> min</span></text>
        <text role="caption" color="bg" align="center"><strong>payments 5xx</strong></text>
      </col>
    </shape>
  </row>
  <connector from="f1" to="outcome" route="curved" from-side="right" to-side="left" variant="plain" end="dot" enter="draw"/>
  <connector from="f2" to="outcome" route="curved" from-side="right" to-side="left" variant="plain" end="dot" enter="draw"/>
  <connector from="f3" to="outcome" route="curved" from-side="right" to-side="left" variant="plain" end="dot" enter="draw"/>
  <connector from="f4" to="outcome" route="curved" from-side="right" to-side="left" variant="plain" end="dot" enter="draw"/>
  <text role="caption" color="muted">Without any one of the four, this would have been 5 minutes, not 47.</text>
  <note>The order is cost to fix. 1 and 4 this week, 2 next sprint.</note>
</slide>
