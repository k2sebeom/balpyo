<!-- Closing: the two slots of the end layout. The title is big enough to carry a slide on its own — the
     end layout is vertically centered, so small type makes the whole slide read as an empty screen. -->
<slide id="end" layout="end" enter="rise">
  <text slot="title" role="title" size="80" align="center">Questions and pushback</text>
  <text slot="contact" role="heading" size="28" color="muted" align="center">Record: <a href="https://example.com/inc-2431">INC-2431 postmortem doc</a> · #incident-2431</text>
  <note>If there is pushback, we change the actions. The point of a postmortem is correction, not consensus.</note>
</slide>
