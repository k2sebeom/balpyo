<!-- Timeline (KST): the 47 minutes on a single **proportional** time axis. x inside the `<stack>` is in
     stage px, and the stack takes the full content width (1152px), so x = (minutes since 14:02 ÷ 47) × 1152
     — 14:14 is 294, 14:23 is 515, 14:31 is 711. The distance between cards is therefore time, and you can
     see the 12 minutes of detection take a quarter of the axis.

     The three bands on top are phases (detect 12 min · mitigate 17 min · recover 18 min — widths use the same
     formula). Only detection is an amber hatch (`pattern(…)`): in the deck's color rule amber is "where we
     were late", and the hatch is "time nobody knew". Mitigate and recover are green — work we did (001_cover).

     Event cards are flags: a card's left edge stands over its event's dot (only the last one, 14:49, sits at
     the end of the axis, so it uses its right edge), and a thin bar joins card and dot. Cards alternate above
     and below so the close events (14:14 · 14:23) don't collide. The dot and bar color is the event's meaning
     (red start · amber late alert · green response). The dots have a `bg` border so they cut the axis line. -->
<slide id="timeline" enter="rise">
  <text variant="kicker">Timeline · KST</text>
  <h2>12 min to detect, 17 to mitigate, 18 to recover</h2>
  <stack w="fill" h="438">
    <shape type="rounded-rect" fill="pattern(wide-diagonal-up accent4/45 bg/0)" border="1 solid accent4" radius="sm" w="290" h="40" x="0" y="0"><text role="caption" color="fg" align="center" anchor="center"><strong>Detect 12 min</strong></text></shape>
    <shape type="rounded-rect" fill="alpha(accent3, 0.18)" border="none" radius="sm" w="413" h="40" x="296" y="0"><text role="caption" color="fg" align="center" anchor="center"><strong>Mitigate 17 min</strong></text></shape>
    <shape type="rounded-rect" fill="alpha(accent3, 0.35)" border="none" radius="sm" w="437" h="40" x="715" y="0"><text role="caption" color="fg" align="center" anchor="center"><strong>Recover 18 min</strong></text></shape>

    <shape type="rect" fill="alpha(muted, 0.6)" border="none" w="1152" h="2" x="0" y="262"/>
    <shape type="rect" fill="accent5" border="none" w="2" h="54" x="9" y="208"/>
    <shape type="ellipse" fill="accent5" border="2 solid bg" w="20" h="20" x="0" y="253"/>
    <shape type="rounded-rect" variant="card" fill="surface" border="none" radius="sm" w="250" h="136" pad="sm md" x="0" y="72">
      <col gap="0"><text role="title" size="34" color="accent5">14:02</text><text role="heading" size="20">Keys expire at once</text><text role="caption" size="16">120k keys in one second</text></col>
    </shape>
    <shape type="rect" fill="accent4" border="none" w="2" h="40" x="293" y="262"/>
    <shape type="ellipse" fill="accent4" border="2 solid bg" w="20" h="20" x="284" y="253"/>
    <shape type="rounded-rect" variant="card" fill="surface" border="none" radius="sm" w="250" h="136" pad="sm md" x="294" y="302">
      <col gap="0"><text role="title" size="34" color="accent4">14:14</text><text role="heading" size="20">5xx alert fires</text><text role="caption" size="16">5-min average, 12 min late</text></col>
    </shape>
    <shape type="rect" fill="muted" border="none" w="2" h="54" x="514" y="208"/>
    <shape type="ellipse" fill="muted" border="2 solid bg" w="20" h="20" x="505" y="253"/>
    <shape type="rounded-rect" variant="card" fill="surface" border="none" radius="sm" w="250" h="136" pad="sm md" x="515" y="72">
      <col gap="0"><text role="title" size="34">14:23</text><text role="heading" size="20">DB pool exhausted</text><text role="caption" size="16">Pool 40/40 · 1,900 queued</text></col>
    </shape>
    <shape type="rect" fill="accent3" border="none" w="2" h="40" x="710" y="262"/>
    <shape type="ellipse" fill="accent3" border="2 solid bg" w="20" h="20" x="701" y="253"/>
    <shape type="rounded-rect" variant="card" fill="surface" border="none" radius="sm" w="250" h="136" pad="sm md" x="711" y="302">
      <col gap="0"><text role="title" size="34" color="accent3">14:31</text><text role="heading" size="20">Load shedding on</text><text role="caption" size="16">Non-payment misses cut</text></col>
    </shape>
    <shape type="rect" fill="accent3" border="none" w="2" h="54" x="1141" y="208"/>
    <shape type="ellipse" fill="accent3" border="2 solid bg" w="20" h="20" x="1132" y="253"/>
    <shape type="rounded-rect" variant="card" fill="surface" border="none" radius="sm" w="250" h="136" pad="sm md" x="902" y="72">
      <col gap="0"><text role="title" size="34">14:49</text><text role="heading" size="20">Error rate normal</text><text role="caption" size="16">Cache hit rate back to 97%</text></col>
    </shape>
  </stack>
  <note>The alert was late because the 5xx threshold is a 5-minute average — that is where action 2 comes from. Distance on the axis is time: see how long the detection band really is.</note>
</slide>
