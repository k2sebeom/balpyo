<!-- 아젠다: two-column 레이아웃 시도 -->
<slide id="agenda" layout="two-column">
  <h2>오늘의 아젠다</h2>
  <row gap="xl" align="start" justify="between">
    <col gap="md">
      <text variant="kicker">돌아보기</text>
      <ul>
        <li>핵심 지표 3종</li>
        <li>가장 큰 학습</li>
      </ul>
    </col>
    <col gap="md">
      <text variant="kicker">내다보기</text>
      <ul>
        <li>Q4 목표</li>
        <li>필요한 투자</li>
      </ul>
    </col>
  </row>
</slide>
