<!-- Agenda — four ordered topics as four circles joined by dashed connectors: a path, not a list. Each
     circle sits centered in its grid cell, and the connectors join the measured circles, so they follow
     along when the cell widths change.

     The first three look back, so they are outlined circles; only the last one (what we decide today) is
     filled — a single color says where this meeting is headed. The line below each previews the numbers
     that topic covers. -->
<slide id="agenda" justify="center" enter="rise">
  <text variant="kicker">Today's agenda</text>
  <h2>Three looks back, one decision</h2>
  <spacer grow="0" basis="24"/>
  <grid cols="4" gap="md">
    <col gap="sm" align="center"><shape type="ellipse" id="a1" fill="bg" border="2 solid accent1" w="120" h="120"><text role="title" size="44" color="accent1" align="center" anchor="center">01</text></shape><text role="heading" size="30" align="center">Key metrics</text><text role="caption" align="center">Users · revenue · rating</text></col>
    <col gap="sm" align="center"><shape type="ellipse" id="a2" fill="bg" border="2 solid accent1" w="120" h="120"><text role="title" size="44" color="accent1" align="center" anchor="center">02</text></shape><text role="heading" size="30" align="center">By channel</text><text role="caption" align="center">Conversion and acquisition cost</text></col>
    <col gap="sm" align="center"><shape type="ellipse" id="a3" fill="bg" border="2 solid accent1" w="120" h="120"><text role="title" size="44" color="accent1" align="center" anchor="center">03</text></shape><text role="heading" size="30" align="center">Biggest lesson</text><text role="caption" align="center">Referral CAC</text></col>
    <col gap="sm" align="center"><shape type="ellipse" id="a4" fill="gradient(accent1 accent6, 135deg)" border="none" shadow="soft" w="120" h="120" enter="zoom"><text role="title" size="44" color="bg" align="center" anchor="center">04</text></shape><text role="heading" size="30" color="accent1" align="center">Q4 plan</text><text role="caption" align="center">What we decide today</text></col>
  </grid>
  <connector from="a1" to="a2" variant="dashed" end="none" enter="draw"/>
  <connector from="a2" to="a3" variant="dashed" end="none" enter="draw"/>
  <connector from="a3" to="a4" variant="accent" enter="draw"/>
  <note>The first three look back; the last one is what we decide today.</note>
</slide>
