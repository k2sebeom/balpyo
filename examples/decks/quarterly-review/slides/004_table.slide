<!-- Performance by channel — the table and the chart say the same numbers twice: the table gives exact
     values, the chart says which value to look at. Header color, stripes and grid lines all belong to the
     theme and `border-collapse`, so the only thing written on the cells is number alignment.

     The chart on the right raises bars for CAC alone. The series color (`series="muted"`) sinks the five
     bars into the background, and `<point fill>` brings two forward — the cheapest, referral (`accent3`),
     and the most expensive, display (`accent5`). Bar labels are short because the cells are narrow
     ("Display" for the table's display ads). Values are in thousands of won (`unit` is only a suffix on
     the value labels, so it cannot add a thousands separator). -->
<slide id="table" enter="rise">
  <text variant="kicker">02 · By channel</text>
  <h2>Referral is cheap, display is expensive</h2>
  <grid cols="3fr 2fr" gap="lg" grow="1">
    <table variant="striped">
      <tr><th>Channel</th><th align="end">New users</th><th align="end">Conv.</th><th align="end">CAC (₩)</th></tr>
      <tr><td>Search</td><td align="end">312K</td><td align="end">4.2%</td><td align="end">12,000</td></tr>
      <tr><td><strong>Referral</strong></td><td align="end">268K</td><td align="end" color="accent3"><strong>7.8%</strong></td><td align="end" color="accent3"><strong>3,200</strong></td></tr>
      <tr><td>Social</td><td align="end">141K</td><td align="end">2.9%</td><td align="end">9,400</td></tr>
      <tr><td>Partners</td><td align="end">63K</td><td align="end">3.5%</td><td align="end">7,100</td></tr>
      <tr><td>Display ads</td><td align="end">38K</td><td align="end">1.1%</td><td align="end" color="accent5">21,500</td></tr>
      <tr><td><strong>Total</strong></td><td align="end"><strong>822K</strong></td><td align="end"><strong>4.6%</strong></td><td align="end"><strong>8,900</strong></td></tr>
    </table>
    <shape variant="card" type="rounded-rect" w="fill" pad="md">
      <col gap="sm" h="fill">
        <text variant="kicker" color="muted">CAC · ₩ thousands</text>
        <chart type="bar" series="muted" max="24" alt="CAC by channel — search 12.0, referral 3.2, social 9.4, partners 7.1, display ads 21.5 (thousands of won)" w="fill" grow="1" basis="0" h="300">
          <point label="Search" value="12.0"/>
          <point label="Referral" value="3.2" fill="accent3"/>
          <point label="Social" value="9.4"/>
          <point label="Partners" value="7.1"/>
          <point label="Display" value="21.5" fill="accent5"/>
        </chart>
      </col>
    </shape>
  </grid>
  <text role="caption">CAC = channel spend ÷ new users. Conversion and CAC in the total row are weighted averages.</text>
  <note>In Q4 the display ad budget moves to referral rewards — the next slides make the case.</note>
</slide>
