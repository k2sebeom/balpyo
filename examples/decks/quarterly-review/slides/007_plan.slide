<!-- Q4 plan — the two-column layout in slot mode. The two slot areas are grid cells that take all the
     height left under the heading (the `1fr` row in `two-column.slots.css`), and each cell is filled by a
     single card with `h="fill"`.

     On the left, each target row is a Q3 → Q4 progress bar: the gray bar is the whole Q4 target and the
     colored bar on top is the share Q3 already reached (`grid cols="29fr 5fr"` — ratios straight from the
     source numbers, like MAU 2.9M / 3.4M). CAC is better when lower, so it gets an arrow line instead of
     a bar.

     On the right, the investment names are the stars of each row, and the band at the bottom is the
     slide's conclusion — zero additional budget. -->
<slide id="plan" layout="two-column" enter="rise">
  <h2 slot="title">Q4 targets and the investment they need</h2>
  <col slot="left" h="fill">
    <shape variant="card" type="rounded-rect" w="fill" h="fill" pad="lg">
      <col gap="md" h="fill" justify="between">
        <text variant="kicker">Targets</text>
        <col gap="xs">
          <row gap="md" align="end" justify="between"><text role="body">Monthly active users</text><text role="title" size="40" color="accent1">3.4M</text></row>
          <grid cols="29fr 5fr" gap="0" w="fill"><shape type="rect" fill="accent1" border="none" w="fill" h="10"/><shape type="rect" fill="alpha(muted, 0.3)" border="none" w="fill" h="10"/></grid>
          <text role="caption">Q3 2.9M · 85% of the way</text>
        </col>
        <col gap="xs">
          <row gap="md" align="end" justify="between"><text role="body">Quarterly revenue</text><text role="title" size="40" color="accent2">₩1.4B</text></row>
          <grid cols="12fr 2fr" gap="0" w="fill"><shape type="rect" fill="accent2" border="none" w="fill" h="10"/><shape type="rect" fill="alpha(muted, 0.3)" border="none" w="fill" h="10"/></grid>
          <text role="caption">Q3 ₩1.2B · 86% of the way</text>
        </col>
        <col gap="xs">
          <row gap="md" align="end" justify="between"><text role="body">Average CAC</text><text role="title" size="40" color="accent3">₩7,000</text></row>
          <text role="caption">Q3 ₩8,900 → −21% · falls as referral share grows</text>
        </col>
      </col>
    </shape>
  </col>
  <col slot="right" h="fill">
    <shape variant="card" type="rounded-rect" w="fill" h="fill" pad="lg">
      <col gap="md" h="fill" justify="between">
        <text variant="kicker">Investment</text>
        <col gap="0">
          <text role="heading" size="26">Double the referral rewards</text>
          <text role="caption">Moved from the display ad budget</text>
        </col>
        <col gap="0">
          <text role="heading" size="26">Onboarding fixes · 2 engineers</text>
          <text role="caption">First-week churn 31% → 24%</text>
        </col>
        <col gap="0">
          <text role="heading" size="26">Fix referral attribution</text>
          <text role="caption">18% of link sign-ups go uncounted</text>
        </col>
        <shape type="rounded-rect" fill="alpha(accent3, 0.14)" border="1 solid accent3" radius="md" w="fill" pad="xs md">
          <text role="body" color="accent3"><strong>No new budget — reallocation only</strong></text>
        </shape>
      </col>
    </shape>
  </col>
  <note>The one thing to decide today is the first line on the right.</note>
</slide>
