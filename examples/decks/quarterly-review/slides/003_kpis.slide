<!-- KPI cards. No card height is written as a number — the grid takes all the height left under the
     heading with `grow="1"`, and grid items stretch by default, so the three cards share that height. Inside
     a card, `justify="between"` places the content in three bands: top (metric name), middle (the number
     and its picture), bottom (the comparison).

     Every number gets a picture of itself — all of them editable shapes in PPTX:
       - Users: a four-quarter curve with the area under it (two `type="path"` shapes overlapped in a `<stack>`).
       - Revenue: five bars for five months (rectangles of different heights in a `<row align="end">`).
       - Rating: five stars — four filled, the fifth translucent (4.6).
     The three pictures share one height (64), so the numbers on all three cards line up. -->
<slide id="kpis" enter="rise">
  <text variant="kicker">01 · Key metrics</text>
  <h2>All three metrics beat their targets</h2>
  <grid cols="3" gap="lg" grow="1">
    <shape variant="stat-card" type="rounded-rect" fill="surface" w="fill" pad="lg">
      <col gap="sm" h="fill" justify="between">
        <text variant="kicker" color="muted">Monthly active users</text>
        <col gap="sm">
          <text role="title" size="80" color="accent1">+38<span size="40">%</span></text>
          <stack w="fill" h="64">
            <shape type="path" fill="alpha(accent1, 0.18)" border="none" w="fill" h="fill" d="M0,88 C20,82 30,78 45,66 C60,54 72,40 100,8 V100 H0 Z"/>
            <shape type="path" fill="none" border="3 solid accent1" w="fill" h="fill" d="M0,88 C20,82 30,78 45,66 C60,54 72,40 100,8"/>
          </stack>
        </col>
        <col gap="0">
          <p>2.1M → 2.9M</p>
          <text role="caption">vs. Q2 · target +30%</text>
        </col>
      </col>
    </shape>
    <shape variant="stat-card" type="rounded-rect" fill="surface" w="fill" pad="lg">
      <col gap="sm" h="fill" justify="between">
        <text variant="kicker" color="muted">Quarterly revenue</text>
        <col gap="sm">
          <text role="title" size="80" color="accent2">₩1.2<span size="40">B</span></text>
          <row gap="xs" align="end" w="fill" h="64">
            <shape type="rect" fill="alpha(accent2, 0.35)" border="none" grow="1" basis="0" h="30"/>
            <shape type="rect" fill="alpha(accent2, 0.35)" border="none" grow="1" basis="0" h="36"/>
            <shape type="rect" fill="alpha(accent2, 0.35)" border="none" grow="1" basis="0" h="42"/>
            <shape type="rect" fill="alpha(accent2, 0.35)" border="none" grow="1" basis="0" h="50"/>
            <shape type="rect" fill="accent2" border="none" grow="1" basis="0" h="64"/>
          </row>
        </col>
        <col gap="0">
          <p>108% of target</p>
          <text role="caption">Subscriptions 74% · ads 26%</text>
        </col>
      </col>
    </shape>
    <shape variant="stat-card" type="rounded-rect" fill="surface" w="fill" pad="lg">
      <col gap="sm" h="fill" justify="between">
        <text variant="kicker" color="muted">App Store rating</text>
        <col gap="sm">
          <text role="title" size="80" color="accent4">4.6</text>
          <row gap="xs" align="center" h="64">
            <shape type="star" fill="accent4" border="none" w="44" h="44"/>
            <shape type="star" fill="accent4" border="none" w="44" h="44"/>
            <shape type="star" fill="accent4" border="none" w="44" h="44"/>
            <shape type="star" fill="accent4" border="none" w="44" h="44"/>
            <shape type="star" fill="alpha(accent4, 0.35)" border="none" w="44" h="44"/>
          </row>
        </col>
        <col gap="0">
          <p>18,400 reviews</p>
          <text role="caption">Q2 4.3 · 1-star reviews −41%</text>
        </col>
      </col>
    </shape>
  </grid>
  <note>Revenue landed at 108% of target. The rating climbed after we fixed the payment errors. More than half of the user growth came from referrals.</note>
</slide>
