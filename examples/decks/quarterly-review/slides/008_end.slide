<!-- Closing — the end layout (vertically centered) in flow mode. A one-line thank-you closes the deck with
     the same gradient as the cover. The decision request below is a badge (`variant="badge"`), so the
     theme decides its shape. -->
<slide id="end" layout="end" enter="rise">
  <text role="title" size="80" align="center"><span color="gradient(accent1 accent6, 90deg)">Thank you</span></text>
  <text role="heading" size="28" color="muted" align="center">Questions to #growth</text>
  <shape variant="badge" type="rounded-rect" pad="xs md" self="center">
    <text role="body" align="center">Today's decision: display budget → referral rewards</text>
  </shape>
  <note>Restate the one decision and close.</note>
</slide>
