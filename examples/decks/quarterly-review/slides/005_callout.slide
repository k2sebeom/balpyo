<!-- The biggest lesson — overlap: a `<stack>` lays one line of claim and a badge over a gradient panel.
     The panel is a gradient of two accent colors, with a centered radial glow (`radial(bg/20 bg/0)`)
     layered on top — both are tokens, so they follow the theme. The overlap panel takes all the remaining
     height with `grow="1"`.

     The two numbers below are the evidence: a connector joins search CAC → referral CAC, and its label
     states the ratio (÷3.75). With the claim and both pieces of evidence on one slide, "the biggest lesson"
     becomes a conclusion rather than an impression. -->
<slide id="callout" enter="rise">
  <text variant="kicker">03 · Biggest lesson</text>
  <stack w="fill" grow="1">
    <shape type="rounded-rect" fill="gradient(accent1 accent6, 120deg)" border="none" radius="lg" shadow="soft" w="fill" h="fill"/>
    <shape type="rounded-rect" fill="radial(bg/20 bg/0)" border="none" radius="lg" w="fill" h="fill"/>
    <col gap="sm" at="center">
      <text role="title" size="60" color="bg" align="center">Referrals cut CAC by 4x</text>
      <text role="heading" size="28" color="bg" align="center">The same budget brings in four times the users</text>
    </col>
    <shape type="rounded-rect" fill="bg" border="none" radius="lg" w="120" h="44" x="1008" y="24" pad="xs">
      <text role="caption" color="accent1" align="center" anchor="center"><strong>NEW</strong></text>
    </shape>
  </stack>
  <row gap="0" align="center">
    <shape type="rounded-rect" id="search" variant="card" w="420" pad="md">
      <row gap="md" align="center" justify="between">
        <text role="body">Search CAC</text>
        <text role="title" size="44" color="muted">₩12,000</text>
      </row>
    </shape>
    <spacer grow="1"/>
    <shape type="rounded-rect" id="referral" variant="card" w="420" pad="md">
      <row gap="md" align="center" justify="between">
        <text role="body">Referral CAC</text>
        <text role="title" size="44" color="accent3">₩3,200</text>
      </row>
    </shape>
  </row>
  <connector from="search" to="referral" variant="accent" label="÷ 3.75" enter="draw"/>
  <note>Four times as much for the same money. That is the basis of the Q4 plan.</note>
</slide>
