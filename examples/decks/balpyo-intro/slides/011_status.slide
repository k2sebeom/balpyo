<!-- Status and next — flow mode, two cards in a `grow="1"` grid take all the space below the title. The
     left lays out what works as badges (`variant="badge"`) — a cluster of badges says "a lot" before a
     list would, and the `wrap` row folds to the card width on its own. The theme sets the badges'
     border and fill.

     The right holds five things to do next. Empty circles stand in for numbers because the order is
     not decided (the backlog picks an order when an item is taken up). -->
<slide id="status" enter="rise">
  <text variant="kicker">Now</text>
  <h1>What works, what's next</h1>
  <grid cols="3fr 2fr" gap="lg" grow="1">
    <shape variant="card" type="rounded-rect" w="fill" pad="lg">
      <col gap="md" h="fill">
        <text variant="kicker" color="accent3">Works today</text>
        <row gap="xs" wrap>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Web + native PPTX</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">11 layouts · slots</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">16 shapes · path</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Tables</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Charts · series</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Connectors</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Animations</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Code highlighting</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">SVG images</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Hatches · gradients</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Inverted slides</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">Backgrounds · logos</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">theme install</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">line:col diagnostics</text></shape>
          <shape variant="badge" type="rounded-rect" pad="xs sm"><text size="18">init · build · check · watch · preview</text></shape>
        </row>
      </col>
    </shape>
    <shape variant="card" type="rounded-rect" w="fill" pad="lg">
      <col gap="md" h="fill">
        <text variant="kicker" color="muted">Next</text>
        <col gap="md">
          <row gap="sm" align="center"><shape type="ellipse" fill="none" border="2 solid muted" w="16" h="16"/><text size="22" grow="1" basis="0">Chapters as PPTX sections</text></row>
          <row gap="sm" align="center"><shape type="ellipse" fill="none" border="2 solid muted" w="16" h="16"/><text size="22" grow="1" basis="0">Chart value prefixes · thousands</text></row>
          <row gap="sm" align="center"><shape type="ellipse" fill="none" border="2 solid muted" w="16" h="16"/><text size="22" grow="1" basis="0">Font size in table cells</text></row>
          <row gap="sm" align="center"><shape type="ellipse" fill="none" border="2 solid muted" w="16" h="16"/><text size="22" grow="1" basis="0">Stretched preset parameters</text></row>
          <row gap="sm" align="center"><shape type="ellipse" fill="none" border="2 solid muted" w="16" h="16"/><text size="22" grow="1" basis="0">English reference docs</text></row>
        </col>
      </col>
    </shape>
  </grid>
  <note>Left is what works today, right is what comes next. The order isn't decided.</note>
</slide>
