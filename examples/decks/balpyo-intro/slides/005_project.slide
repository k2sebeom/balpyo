<!-- Project layout — the code layout (flow). On the left, a directory tree inside a window-shaped
     card: the three dots and the path line in the title bar say "this is a file system", and `pre`
     preserves the whitespace verbatim. On the right stand the four collection rules, each with a
     numbered circle — the audience pairs each number with a line of the tree.

     The strip at the bottom shows one command like a terminal: `fill="fg"` with `color="bg"` text, so
     it is a dark strip in light themes and a light strip in dark themes — either way, the surface
     opposite the background means "type here". Only the prompt symbol is an accent. -->
<slide id="project" layout="code" enter="rise">
  <text variant="kicker">Project</text>
  <h1>One project is one deck</h1>
  <grid cols="5fr 6fr" gap="xl" grow="1">
    <shape variant="card" type="rounded-rect" w="fill" pad="0">
      <col gap="0" h="fill">
        <shape type="rect" fill="surface" border="none" w="fill" pad="sm md">
          <row gap="xs" align="center">
            <shape type="ellipse" fill="accent5" border="none" w="12" h="12"/>
            <shape type="ellipse" fill="accent4" border="none" w="12" h="12"/>
            <shape type="ellipse" fill="accent3" border="none" w="12" h="12"/>
            <text role="code" size="15" color="muted">  ~/talks/my-deck</text>
          </row>
        </shape>
        <col gap="0" pad="md lg" grow="1">
          <pre size="19">my-deck/
  balpyo.json        ⑤
  slides/
    001_cover.slide  ①
    002_problem.slide
    _draft.slide     ③
    chapter-2/       ④
  assets/
  themes/my-brand/</pre>
        </col>
      </col>
    </shape>
    <col gap="md" justify="center">
      <row gap="md" align="center"><shape type="ellipse" fill="accent1" border="none" w="40" h="40"><text role="caption" color="bg" align="center" anchor="center"><strong>1</strong></text></shape><text role="body" size="22" grow="1" basis="0">One slide is one file</text></row>
      <row gap="md" align="center"><shape type="ellipse" fill="accent1" border="none" w="40" h="40"><text role="caption" color="bg" align="center" anchor="center"><strong>2</strong></text></shape><text role="body" size="22" grow="1" basis="0">Sorted by path — numeric prefixes set the order</text></row>
      <row gap="md" align="center"><shape type="ellipse" fill="accent1" border="none" w="40" h="40"><text role="caption" color="bg" align="center" anchor="center"><strong>3</strong></text></shape><text role="body" size="22" grow="1" basis="0"><code>_</code>-prefixed files are skipped (drafts)</text></row>
      <row gap="md" align="center"><shape type="ellipse" fill="accent1" border="none" w="40" h="40"><text role="caption" color="bg" align="center" anchor="center"><strong>4</strong></text></shape><text role="body" size="22" grow="1" basis="0">Subdirectories become chapters</text></row>
      <row gap="md" align="center"><shape type="ellipse" fill="accent6" border="none" w="40" h="40"><text role="caption" color="bg" align="center" anchor="center"><strong>5</strong></text></shape><text role="body" size="22" grow="1" basis="0">Deck settings live in one file: <code>balpyo.json</code></text></row>
    </col>
  </grid>
  <shape type="rounded-rect" fill="fg" border="none" radius="md" w="fill" pad="sm md">
    <text role="code" size="20" color="bg"><span color="accent3">$</span> balpyo build --project my-deck --target html,pptx</text>
  </shape>
  <note>All deck settings live in balpyo.json — title, author, language, aspect, theme, output path, footer, page numbers.</note>
</slide>
