<!-- Pipeline — content in flow mode. Seven boxes and eight connectors trace the path of one build:
     .slide file → soml (parse) → core (resolve) → web render → measure → PPTX render, and the two
     outputs. A `<row>` places the boxes, and `<connector>`s — direct children of the slide — join the
     measured boxes. Lines take no space in the flow, so the boxes are laid out first and the lines
     are drawn over them. In PPTX these are real connectors glued to the boxes: drag a box and its
     lines follow.

     The middle column (web · measure · PPTX) is the point of the tool: the PPTX renderer computes no
     coordinates — it bakes the rects that headless Chromium measured on the web render. Only those
     two arrows are `accent`, and only the measure box has a dashed border — where the coordinates
     come from is this slide's question.

     The bottom row holds the two output cards. The diagram row takes the leftover height with
     `grow="1"` — the boxes sit at its vertical center, and the cards take only their content height. -->
<slide id="pipeline" enter="rise">
  <text variant="kicker">The path of one build</text>
  <h1>One source, two outputs</h1>
  <row gap="0" align="center" grow="1">
    <shape type="rounded-rect" id="src" variant="card" w="150" h="88" pad="sm">
      <col gap="0" justify="center" h="fill"><text role="code" size="18">.slide</text><text role="caption" size="16">SOML source</text></col>
    </shape>
    <spacer grow="1"/>
    <shape type="rounded-rect" id="parse" variant="card" w="150" h="88" pad="sm">
      <col gap="0" justify="center" h="fill"><text role="heading" size="22">soml</text><text role="caption" size="16">Parse · check</text></col>
    </shape>
    <spacer grow="1"/>
    <shape type="rounded-rect" id="resolve" variant="card" w="150" h="88" pad="sm">
      <col gap="0" justify="center" h="fill"><text role="heading" size="22">core</text><text role="caption" size="16">Style · assets</text></col>
    </shape>
    <spacer grow="1"/>
    <col gap="md" w="210">
      <shape type="rounded-rect" id="web" variant="card" w="fill" h="76" pad="xs sm">
        <col gap="0" justify="center" h="fill"><text role="heading" size="20">render/web</text><text role="caption" size="16">HTML + CSS</text></col>
      </shape>
      <shape type="rounded-rect" id="geom" fill="alpha(accent1, 0.12)" border="2 dashed accent1" radius="md" w="fill" h="76" pad="xs sm">
        <col gap="0" justify="center" h="fill"><text role="heading" size="20" color="accent1">render/geom</text><text role="caption" size="16">Chromium measures</text></col>
      </shape>
      <shape type="rounded-rect" id="pptx" variant="card" w="fill" h="76" pad="xs sm">
        <col gap="0" justify="center" h="fill"><text role="heading" size="20">render/pptx</text><text role="caption" size="16">Measured rect → EMU</text></col>
      </shape>
    </col>
    <spacer grow="1"/>
    <col gap="md" w="160">
      <shape type="rounded-rect" id="html" fill="accent1" border="none" radius="md" shadow="soft" w="fill" h="76" pad="xs sm">
        <text role="code" size="18" color="bg" align="center" anchor="center">index.html</text>
      </shape>
      <shape type="rect" fill="none" border="none" w="fill" h="76"/>
      <shape type="rounded-rect" id="deck" fill="accent6" border="none" radius="md" shadow="soft" w="fill" h="76" pad="xs sm">
        <text role="code" size="18" color="bg" align="center" anchor="center">deck.pptx</text>
      </shape>
    </col>
  </row>
  <connector from="src" to="parse" enter="draw"/>
  <connector from="parse" to="resolve" enter="draw"/>
  <connector from="resolve" to="web" route="elbow" from-side="right" to-side="left" enter="draw"/>
  <connector from="resolve" to="pptx" route="elbow" from-side="right" to-side="left" enter="draw"/>
  <connector from="web" to="geom" variant="accent" enter="draw"/>
  <connector from="geom" to="pptx" variant="accent" enter="draw"/>
  <connector from="web" to="html" enter="draw"/>
  <connector from="pptx" to="deck" enter="draw"/>
  <grid cols="2" gap="lg">
    <shape variant="card" type="rounded-rect" w="fill" pad="md">
      <row gap="md" align="center" h="fill">
        <shape type="rect" fill="accent1" border="none" w="4" h="fill"/>
        <col gap="xs" grow="1" basis="0">
          <text role="heading" size="24">Web · one file</text>
          <text role="body" size="19" color="muted">Inline CSS · presenter · overview · PDF</text>
        </col>
      </row>
    </shape>
    <shape variant="card" type="rounded-rect" w="fill" pad="md">
      <row gap="md" align="center" h="fill">
        <shape type="rect" fill="accent6" border="none" w="4" h="fill"/>
        <col gap="xs" grow="1" basis="0">
          <text role="heading" size="24">PPTX · an editable original</text>
          <text role="body" size="19" color="muted">Text · shapes · tables · lines — not images</text>
        </col>
      </row>
    </shape>
  </grid>
  <note>soml parses, core resolves, render/geom measures, and render/web and render/pptx render. The PPTX renderer computes no coordinates — it bakes what the browser measured.</note>
</slide>
