<!-- Closing — the end layout (vertically centered) in flow mode. The second half of the title is the
     same gradient as the cover, so the first and last slides read as a pair. The three commands are
     the deck's last to-do — create, build, and watch while you edit. The command strips are
     `fill="fg"` with `color="bg"` text, so in any theme they are the surface opposite the background,
     and only the prompt symbol is an accent. The row is a `w="fill"` grid, so the three strips split
     the stage width. -->
<slide id="end" layout="end" enter="rise">
  <text role="title" size="80" align="center"><span color="gradient(accent1 accent6, 90deg)">Write once</span> in SOML</text>
  <text role="heading" size="30" color="muted" align="center">balpyo renders the rest, to both targets</text>
  <grid cols="3" gap="md" w="fill">
    <shape type="rounded-rect" fill="fg" border="none" radius="md" shadow="soft" w="fill" h="68" pad="sm">
      <text role="code" color="bg" align="center" anchor="center"><span color="accent3">$</span> balpyo init my-talk</text>
    </shape>
    <shape type="rounded-rect" fill="fg" border="none" radius="md" shadow="soft" w="fill" h="68" pad="sm">
      <text role="code" color="bg" align="center" anchor="center"><span color="accent3">$</span> balpyo build</text>
    </shape>
    <shape type="rounded-rect" fill="fg" border="none" radius="md" shadow="soft" w="fill" h="68" pad="sm">
      <text role="code" color="bg" align="center" anchor="center"><span color="accent3">$</span> balpyo watch</text>
    </shape>
  </grid>
  <note>Take questions. Encourage everyone to download the deck as PPTX and edit it themselves.</note>
</slide>
